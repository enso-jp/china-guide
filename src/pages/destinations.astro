---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { byLaunch, corridorOrder } from '../lib/taxonomy';

const places = byLaunch(await getCollection('places'));
const groups = corridorOrder
  .map((corridor) => ({
    ...corridor,
    places: places.filter((place) => place.data.corridor === corridor.id),
  }))
  .filter((group) => group.places.length > 0);
---

<Base title="Destinations" description="Destinations in China.">
  <div class="wrap page">
    <h1>Destinations</h1>
    {
      groups.length === 0 ? (
        <p class="note">No destinations published.</p>
      ) : (
        groups.map((group) => (
          <section>
            <h2>{group.name}</h2>
            <ul class="index-list">
              {group.places.map((place) => (
                <li>
                  <a href={`/${place.id}`}>{place.data.name}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</Base>
